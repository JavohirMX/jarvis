# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
DB_NAME=jarvis
DB_USER=ai_assistant_user
DB_PASSWORD=your-password-here
DB_HOST=localhost
DB_PORT=5432

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# AI API Keys
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Token Limits (defaults)
DEFAULT_DAILY_TOKEN_LIMIT=10000
DEFAULT_MONTHLY_TOKEN_LIMIT=100000
PREMIUM_DAILY_TOKEN_LIMIT=50000
PREMIUM_MONTHLY_TOKEN_LIMIT=500000

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# AI Provider Selection
DEFAULT_AI_PROVIDER=openai  # Options: openai, anthropic, gemini
DEFAULT_AI_MODEL=  # Leave empty to use provider default

# AI API Keys (add the ones you'll use)
GEMINI_API_KEY=your-gemini-api-key-here
